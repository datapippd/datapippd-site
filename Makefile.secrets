# Secret scan, copied from datapippd/cerne (Makefile target `secrets`, .secretscan-allow, .githooks) for MIG-01 step 5.10.
# Include from a repo Makefile with `include templates/secretscan/Makefile.secrets` or copy the file to the repo root as Makefile.secrets.
# Run from a POSIX shell (Git Bash on Windows). gitleaks in CI is the authority; this is the local first line.
# Secret scan of the working tree (every file git can see) and of the staged content, no file excluded (-a reads a
# file git would call binary as text); either one failing fails the target, and so does a scan that cannot run.
# A hit is skipped only when its whole line appears verbatim in .secretscan-allow and begins "export SECRET_RE",
# that is, only a line that defines these patterns, or when it carries the inline marker "# secret-scan: ok", matches
# no vendor pattern (SECRET_RE_VENDOR), and every name-rule value on it is a dotted lookup, a call on a quoted
# environment name, or a quoted environment name (uppercase letters, digits and underscores); anything else is a hit
#. Under ip/artifacts/ and ip/way-of-working/ only, a hit is also skipped when .secretscan-allow lists
# its path and its full line as "<path>:<line>", for a false positive in a verbatim closed artifact; any change to the
# line lapses the entry. UTF-16 files are not scanned. Run from Git Bash. With SCAN_RANGE=<git log range> on the command line
# (.githooks/pre-push), the scan reads instead every line each commit of the range adds, reported as commit: file:line.
# Catches sk-, gh*_ and github_pat_, sk_live_, AKIA, PEM private key headers, Bearer tokens, passwords in URLs, and
# any name ending in the whole word key, token, secret or password (api_key, API_KEY, apiKey, APIKey; not keyword,
# not monkey) assigned a value of 20 or more characters. Prints file:line only, never the matched value.
export SECRET_RE_VENDOR := (^|[^A-Za-z0-9])sk-[A-Za-z0-9_-]{16,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk_(live|test)_[A-Za-z0-9]{16,}|AKIA[0-9A-Z]{16}|-----BEGIN[A-Z ]*PRIVATE KEY|[Bb][Ee][Aa][Rr][Ee][Rr][[:space:]]+[A-Za-z0-9._~+/=-]{20,}|[A-Za-z][A-Za-z0-9+.-]*://[^/[:space:]:@]*:[^/[:space:]@]{8,}@
export SECRET_RE_NAME_LHS := (^|[^A-Za-z0-9_.-])(([A-Za-z0-9_.-]*[_.-])?([Kk]ey|KEY|[Tt]oken|TOKEN|[Ss]ecret|SECRET|[Pp]assword|PASSWORD)|[A-Za-z0-9_.-]*[A-Za-z0-9](Key|Token|Secret|Password)|[A-Za-z0-9_.-]*[a-z0-9](KEY|TOKEN|SECRET|PASSWORD))\\?["']?[[:space:]]*(:[[:space:]]*[A-Za-z_][A-Za-z0-9_.]*[[:space:]]*)?[:=][[:space:]]*
export SECRET_RE_NAME_VALUE := (\\?["'][^$$"'\\][^"'\\]{19,}\\?["']|[A-Za-z_][A-Za-z0-9_.]*\([[:space:]]*["'][^$$"'][^"']{19,}["']|[^$$[:space:]"'(),;\\][^[:space:]"'(),;\\]{19,}([[:space:]"'),;\\]|$$))
export SECRET_RE := $(SECRET_RE_VENDOR)|$(SECRET_RE_NAME_LHS)$(SECRET_RE_NAME_VALUE)
secrets:
	@if [ "$(origin SCAN_RANGE)" = "command line" ]; then \
	  log=$$(git -c core.quotePath=false log -p -a -U0 --diff-merges=first-parent --no-color --no-ext-diff --no-textconv --no-renames --src-prefix=a/ --dst-prefix=b/ \
	    --format='commit %h' $(SCAN_RANGE) --) || { echo "secret scan could not run (git log $(SCAN_RANGE) failed)"; exit 2; }; \
	  added=$$(printf '%s\n' "$$log" | awk '/^commit / { c = $$2; next } /^diff --git / { h = 1; next } h && /^\+\+\+ / { f = substr($$0, 7); next } \
	    /^@@ / { h = 0; split($$3, a, ","); n = substr(a[1], 2) + 0; next } !h && /^\+/ { print c ":" f ":" n ":" substr($$0, 2); n++ } END { print "read-ok" }'); \
	  case "$$added" in *read-ok) added=$${added%read-ok};; *) echo "secret scan could not run (the diff reader failed)"; exit 2;; esac; \
	  found=$$(printf '%s' "$$added" | grep -a -E -e "$$SECRET_RE"); g=$$?; \
	  if [ $$g -gt 1 ]; then echo "secret scan could not run (grep exit $$g)"; exit 2; fi; \
	else \
	  tree=$$(git grep --untracked -a -n --no-color --no-column -E -e "$$SECRET_RE" -- .); t=$$?; \
	  staged=$$(git grep --cached -a -n --no-color --no-column -E -e "$$SECRET_RE" -- .); s=$$?; \
	  if [ $$t -gt 1 ] || [ $$s -gt 1 ]; then echo "secret scan could not run (git grep exit $$t and $$s)"; exit 2; fi; \
	  found=$$( { [ $$t -ne 0 ] || printf '%s\n' "$$tree" | while IFS= read -r x; do printf 'working tree:%s\n' "$$x"; done; \
	    [ $$s -ne 0 ] || printf '%s\n' "$$staged" | while IFS= read -r x; do printf 'staged:%s\n' "$$x"; done; } ); \
	fi; \
	hits=$$( { [ -z "$$found" ] || printf '%s\n' "$$found"; } \
	  | awk 'function okval(v,  b) { b = sprintf("%c", 92); if (substr(v, 1, 1) == b) v = substr(v, 2); \
	      if (v ~ /^["\047]/) { v = substr(v, 2); sub(/["\047]$$/, "", v); if (substr(v, length(v)) == b) v = substr(v, 1, length(v) - 1); return v ~ /^[A-Z0-9_]+$$/ } \
	      if (v ~ /^[A-Za-z_][A-Za-z0-9_.]*\(/) { sub(/^[^(]*\([[:space:]]*["\047]/, "", v); sub(/["\047]$$/, "", v); return v ~ /^[A-Z0-9_]+$$/ } \
	      if (substr(v, length(v)) == b) v = substr(v, 1, length(v) - 1); else sub(/[[:space:]"\047),;]$$/, "", v); \
	      return v ~ /^[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)+$$/ } \
	  function marked(l,  r, m, n) { if (!index(l, "# secret-scan: ok") || l ~ ENVIRON["SECRET_RE_VENDOR"]) return 0; r = l; n = 0; \
	    while (match(r, ENVIRON["SECRET_RE_NAME_LHS"] ENVIRON["SECRET_RE_NAME_VALUE"])) { m = substr(r, RSTART, RLENGTH); r = substr(r, RSTART + RLENGTH); n++; \
	      match(m, "^" ENVIRON["SECRET_RE_NAME_LHS"]); if (!okval(substr(m, RLENGTH + 1))) return 0 } \
	    return n > 0 } \
	  BEGIN { while ((getline a < ".secretscan-allow") > 0) { sub(/\r$$/, "", a); if (index(a, "export SECRET_RE") == 1) ok[a] = 1; \
	      p = a; sub(/:.*/, "", p); if (p ~ /^ip[/](artifacts|way-of-working)[/]/ && !index(p, "..") && length(a) > length(p) + 1) at[a] = 1 } } \
	  { split($$0, f, ":"); l = $$0; sub(/^[^:]*:[^:]*:[^:]*:/, "", l); sub(/\r$$/, "", l); \
	    if (!(l in ok) && !((f[2] ":" l) in at) && !(f[2] == ".secretscan-allow" && (l in at)) && !marked(l)) print f[1] ": " f[2] ":" f[3] } END { print "scan-filter-ok" }'); \
	case "$$hits" in *scan-filter-ok) hits=$${hits%scan-filter-ok};; *) echo "secret scan could not run (the filter failed)"; exit 2;; esac; \
	if [ -n "$$hits" ]; then printf '%s' "$$hits"; echo "secret strings found"; exit 1; fi; \
	echo "no secret strings found"
